{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🤖 Start Local AI Server (YOLO)",
      "detail": "รัน YOLO model server บน port 3000 — ต้องรันก่อนใช้ AI Inspect",
      "type": "shell",
      "command": "node scripts/local-ai-server.js",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "WQIS local AI server",
          "endsPattern": "WQIS local AI server"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "group": "none"
    },
    {
      "label": "🔄 Reload Browser (WQIS-PRO3S)",
      "detail": "โหลด browser ใหม่ → เปิด localhost:3000 (Local AI Server)",
      "type": "shell",
      "command": "Start-Process 'chrome' -ArgumentList 'http://localhost:3000/WQIS-PRO3S.html'",
      "options": {
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NoProfile", "-Command"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "focus": false,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "🚀 Deploy to Netlify",
      "detail": "บันทึกและ Deploy ขึ้น Netlify อัตโนมัติ",
      "type": "shell",
      "command": "git add -A && git commit -m \"${input:commitMessage}\" && git push",
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "panel": "new",
        "focus": true,
        "clear": true,
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "📊 Open Netlify Dashboard",
      "detail": "เปิด Netlify Deploy Dashboard",
      "type": "shell",
      "command": "start https://app.netlify.com/sites/pro3s-wqis/deploys",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "🌐 Open Live Site",
      "detail": "เปิดเว็บไซต์ WQIS ที่ใช้งานจริง",
      "type": "shell",
      "command": "start https://pro3s-wqis.netlify.app",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "📝 ข้อความ Commit (Commit message)",
      "default": "Update ${currentDatetime}"
    }
  ]
}
